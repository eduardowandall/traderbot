HELIUS_RPC_URL=sua_chave_api_aqui
SOLANA_PRIVATE_KEY=seu_secret_aqui
# opcional: notificações via --notification-service telegram
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
# opcional: API de quote/swap da Jupiter. api.jup.ag funciona sem chave
# (rate limit menor); crie uma em https://developers.jup.ag/portal para um
# limite maior.
JUPITER_API_URL=
JUPITER_API_KEY=
# opcional: onde fica o estado (ledger, HALT, carteira paper) e a política.
# Padrão: <raiz do projeto>/.data e <raiz do projeto>/policy.toml, de qualquer
# diretório. Caminhos relativos são resolvidos a partir da raiz do projeto.
TRADER_DATA_DIR=
TRADER_POLICY_FILE=
