# modo real: RPC da Solana (Helius) e a chave da carteira (base58)
HELIUS_RPC_URL=sua_chave_api_aqui
SOLANA_PRIVATE_KEY=seu_secret_aqui
# opcional: conferida contra a chave derivada
SOLANA_PUBLIC_KEY=
# opcional: com os dois preenchidos, o `run` notifica no Telegram
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
# opcional: API de quote/swap da Jupiter. api.jup.ag funciona sem chave
# (rate limit menor); crie uma em https://developers.jup.ag/portal para um
# limite maior.
JUPITER_API_URL=
JUPITER_API_KEY=
# opcional: onde ficam o estado (ledger, carteira paper), a política e os logs.
# Padrão: <raiz do projeto>/.data, <raiz>/policy.toml e <raiz>/.logs, de
# qualquer diretório. Caminhos relativos são resolvidos a partir da raiz.
TRADER_DATA_DIR=
TRADER_POLICY_FILE=
TRADER_LOG_DIR=
